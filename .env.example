# ==============================================================================
# HOPE COMMUNITY SUPPORT - FIREBASE & APPLICATION CONFIGURATION
# Copy to .env or inject via Cloud Run / Vite Environment Variables
# IMPORTANT: Never commit actual secret values to version control.
# ==============================================================================

# Application Runtime Port
PORT=

# Application Base URL
APP_URL=

# Environment mode ('production' | 'development')
NODE_ENV=

# Firebase Client Configuration (Vite Environment Variables)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email Dispatch (SMTP for intake notices and clinic confirmations)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Gemini API Key for Assisted Note Drafting
GEMINI_API_KEY=
