# ==============================================================================
# HOPE COMMUNITY SUPPORT - PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env or inject via Google Secret Manager / Cloud Run Environment Variables
# IMPORTANT: Never commit actual secret values to version control.
# ==============================================================================

# Application Runtime Port (Cloud Run injects PORT automatically)
PORT=

# Application Base URL (e.g. https://hope-community-support-xxx.a.run.app)
APP_URL=

# Environment mode ('production' | 'development')
NODE_ENV=

# Production Database (Cloud SQL PostgreSQL connection string)
# Example format: postgresql://username:password@/dbname?host=/cloudsql/project:region:instance
DATABASE_URL=

# Cryptographic Session & JWT Secret (Generate with: openssl rand -base64 32)
SESSION_SECRET=

# Google Cloud Storage Bucket for Private Clinical Documents
GCS_BUCKET_NAME=

# Email Dispatch (SMTP or SendGrid for client confirmations & verification)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Gemini API Key for Assisted Clinical Note Drafting
GEMINI_API_KEY=
